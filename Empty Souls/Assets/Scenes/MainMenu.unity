  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "# \u0421\u043F\u0440\u0430\u0432\u043A\u0430 / \u041A\u0430\u043A \u0438\u0433\u0440\u0430\u0442\u044C\n\n**Empty
    Souls** \u2014 \u044D\u0442\u043E \u044D\u043A\u0448\u0435\u043D-roguelite \u043F\u0440\u043E
    \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435, \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u044E
    \u0438 \u0441\u0431\u043E\u0440 \u043C\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u043E\u0432 \u0432 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E
    \u043E\u043F\u0430\u0441\u043D\u043E\u043C \u043C\u0438\u0440\u0435!\n## \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0446\u0435\u043B\u044C\n\n- \u0418\u0441\u0441\u043B\u0435\u0434\u0443\u0439
    \u043A\u0430\u0440\u0442\u0443, \u0441\u0440\u0430\u0436\u0430\u0439\u0441\u044F
    \u0441 \u043E\u0440\u0434\u0430\u043C\u0438 \u0432\u0440\u0430\u0433\u043E\u0432,
    \u0441\u043E\u0431\u0438\u0440\u0430\u0439 **\u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442\u044B
    \u0434\u0443\u0448\u0438** \u0438 \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u043E\u043D\u0438\u0440\u0443\u0439,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435!\n-
    \u041F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C \u043A\u0430\u043A
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u043B\u044C\u0448\u0435, \u043F\u043E\u0431\u0435\u0434\u0438
    \u0431\u043E\u0441\u0441\u043E\u0432, \u043E\u0442\u043A\u0440\u043E\u0439 \u043D\u043E\u0432\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0438 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439.\n\n##
    \u041E\u0441\u043D\u043E\u0432\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\n-
    **\u041F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435:**
    WASD \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0438\n- **\u0410\u0442\u0430\u043A\u0430/\u0410\u0432\u0442\u043E\u0430\u0442\u0430\u043A\u0430:**
    \u041E\u0440\u0443\u0436\u0438\u0435 \u0430\u0442\u0430\u043A\u0443\u0435\u0442
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\n-
    **\u0410\u043A\u0442\u0438\u0432\u043D\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C:**
    [\u041F\u0440\u043E\u0431\u0435\u043B] (\u0435\u0441\u043B\u0438 \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0430)\n-
    **\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435:**
    [E]\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
